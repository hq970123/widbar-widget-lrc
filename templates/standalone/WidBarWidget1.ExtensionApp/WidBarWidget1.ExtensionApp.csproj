<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WidBarWidget1.ExtensionApp</RootNamespace>
    <AssemblyName>WidBarWidget1.ExtensionApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <WidBarPluginId>com.qiong.widbar.lyrics</WidBarPluginId>
    <WidBarPluginName>Lyrics</WidBarPluginName>
    <WidBarPluginDescription>Display synchronized LRC lyrics directly on the Windows 11 taskbar.</WidBarPluginDescription>
    <WidBarPluginCategory>Media</WidBarPluginCategory>
    <WidBarPluginVersion>0.1.0</WidBarPluginVersion>
    <WidBarPluginPreviewWidth>320</WidBarPluginPreviewWidth>
    <WidBarPluginConfigurable>true</WidBarPluginConfigurable>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="WidBar.SDK" Version="2.0.5" />
  </ItemGroup>

</Project>
